#include <stdio.h>

/* Function to check leap year: returns 1 if leap, 0 if not */
int isLeap(int year)
{
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
        return 1;
    else
        return 0;
}

/* Function to return number of days in a month */
int getDays(int month, int year)
{
    switch (month)
    {
        case 1: case 3: case 5: case 7: case 8: case 10: case 12:
            return 31;
        case 4: case 6: case 9: case 11:
            return 30;
        case 2:
            if (isLeap(year))
                return 29;
            else
                return 28;
    }
    return 0;
}

/* Function to print the name of a month */
void printMonthName(int month)
{
    switch (month)
    {
        case 1:  printf("January");   break;
        case 2:  printf("February");  break;
        case 3:  printf("March");     break;
        case 4:  printf("April");     break;
        case 5:  printf("May");       break;
        case 6:  printf("June");      break;
        case 7:  printf("July");      break;
        case 8:  printf("August");    break;
        case 9:  printf("September"); break;
        case 10: printf("October");   break;
        case 11: printf("November");  break;
        case 12: printf("December");  break;
    }
}

int main()
{
    int year, month, day, days, i;
    int startDay;     /* 0 = Sunday, 1 = Monday, ... 6 = Saturday */

    printf("Enter the year: ");
    scanf("%d", &year);

    /* Find the weekday of 1 January of the given year
       (0 = Sunday, 1 = Monday, ... 6 = Saturday) */
    startDay = (1 + 5 * ((year - 1) % 4)
                  + 4 * ((year - 1) % 100)
                  + 6 * ((year - 1) % 400)) % 7;

    /* Print the calendar of all 12 months */
    for (month = 1; month <= 12; month++)
    {
        days = getDays(month, year);

        /* Month heading */
        printf("\n====== ");
        printMonthName(month);
        printf(" %d ======\n", year);
        printf("  Su  Mo  Tu  We  Th  Fr  Sa\n");

        /* Leave blank spaces before the 1st day */
        for (i = 0; i < startDay; i++)
            printf("    ");

        /* Print the dates */
        for (day = 1; day <= days; day++)
        {
            printf("%4d", day);

            /* Go to next line after Saturday */
            if ((startDay + day) % 7 == 0)
                printf("\n");
        }
        printf("\n");

        /* The next month starts on this day */
        startDay = (startDay + days) % 7;
    }

    return 0;
}
